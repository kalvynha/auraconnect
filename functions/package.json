{
  "name": "auraconnect-functions",
  "private": true,
  "description": "AuraConnect Cloud Functions backend",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage,tasks",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
