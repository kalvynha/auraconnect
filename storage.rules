rules_version = '2';

// AuraConnect Cloud Storage security rules.
//
// Contract: docs/DATA_MODEL.md ("Storage" table and the v2 "New Storage path").
//  - Claims {orgId, role} are the primary gate. Cross-service Firestore reads
//    additionally require an active member doc (immediate revocation) and,
//    for attachments, membership of the channel.
//  - Objects are write-once from clients: `create` is allowed, overwrite
//    (`update`) and `delete` are not, so an uploaded referral or attachment
//    cannot be swapped out after the fact. Cloud Functions (Admin SDK)
//    bypass these rules.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function claimOrg(orgId) {
      return signedIn() && request.auth.token.orgId == orgId;
    }

    function memberDoc(orgId) {
      return firestore.get(/databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }

    function isActiveMember(orgId) {
      return claimOrg(orgId) && memberDoc(orgId).data.active == true;
    }

    function hasRole(orgId, roles) {
      return isActiveMember(orgId)
        && request.auth.token.role in roles
        && memberDoc(orgId).data.role in roles;
    }

    // v3: Aide/LPN members with role `viewer` may post messages (and so
    // upload attachments). Mirrors canPost() in firestore.rules.
    function canPost(orgId) {
      return hasRole(orgId, ['admin', 'clinician', 'intake'])
        || (hasRole(orgId, ['viewer']) && memberDoc(orgId).data.discipline in ['Aide', 'LPN']);
    }

    // v3 minimum-necessary: a non-admin member whose discipline is Volunteer.
    function isVolunteer(orgId) {
      return isActiveMember(orgId)
        && memberDoc(orgId).data.discipline == 'Volunteer'
        && !hasRole(orgId, ['admin']);
    }

    // Channel attachments: images (never SVG, which can carry script), PDF,
    // plain text and common office documents. Never text/html.
    function isAllowedAttachmentType(ct) {
      return ct != null
        && ct is string
        && ((ct.matches('image/.*') && !ct.lower().matches('image/svg.*'))
            || ct in ['application/pdf',
                      'text/plain',
                      'application/msword',
                      'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                      'application/vnd.ms-excel',
                      'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                      'application/vnd.ms-powerpoint',
                      'application/vnd.openxmlformats-officedocument.presentationml.presentation']);
    }

    // Belt and braces with `update: if false`: some emulator versions
    // evaluate an overwrite as `create`, so also require no existing object.
    function isNewObject() {
      return resource == null;
    }

    function underMaxSize() {
      return request.resource.size < 25 * 1024 * 1024;
    }

    // Referral documents (scanned/uploaded PDFs or images).
    match /orgs/{orgId}/referrals/{referralId}/{fileName} {
      allow read: if hasRole(orgId, ['admin', 'clinician', 'intake']);
      allow create: if isNewObject()
        && hasRole(orgId, ['admin', 'clinician', 'intake'])
        && underMaxSize()
        && request.resource.contentType != null
        // v3 (I1): exactly REFERRAL_MIME_TYPES in shared/types.ts (what the extractor accepts).
        && request.resource.contentType in ['application/pdf', 'image/png', 'image/jpeg', 'image/webp', 'image/heic', 'image/heif'];
      allow update, delete: if false;
    }

    // Message attachments, visible to channel members only.
    match /orgs/{orgId}/channels/{channelId}/attachments/{fileName} {
      function isChannelMember() {
        return isActiveMember(orgId)
          && request.auth.uid in firestore.get(/databases/(default)/documents/orgs/$(orgId)/channels/$(channelId)).data.memberUids;
      }

      allow read: if isChannelMember();
      // Only members who can post messages may upload attachments (plain
      // viewers cannot; v3 Aide/LPN viewers can).
      allow create: if isNewObject()
        && isChannelMember()
        && canPost(orgId)
        && underMaxSize()
        && isAllowedAttachmentType(request.resource.contentType);
      allow update, delete: if false;
    }

    // Patient documents (consents, POLST, orders, plan of care…). The
    // Firestore record at orgs/{orgId}/patients/{patientId}/documents/{docId}
    // is created first; the file is then uploaded here.
    // v3: volunteers read only files of patients whose `volunteerUids`
    // (backend-maintained from active volunteer assignments) contains them.
    // Cross-service reads: member doc + patient doc.
    match /orgs/{orgId}/patients/{patientId}/documents/{docId}/{fileName} {
      allow read: if isActiveMember(orgId)
        && (!isVolunteer(orgId)
            || request.auth.uid in firestore.get(/databases/(default)/documents/orgs/$(orgId)/patients/$(patientId)).data.get('volunteerUids', []));
      allow create: if isNewObject()
        && hasRole(orgId, ['admin', 'clinician', 'intake'])
        && underMaxSize()
        && request.resource.contentType != null
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/.*'));
      allow update, delete: if false;
    }

    // Default deny: no other paths match.
  }
}
