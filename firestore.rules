rules_version = '2';

// AuraConnect Firestore security rules.
//
// Contract: docs/DATA_MODEL.md ("Collections" table) and
// functions/src/shared/types.ts (document shapes).
//
// Access model:
//  - Custom claims {orgId, role} (set only by Cloud Functions) are the primary
//    gate. In addition, every org-scoped check reads the caller's
//    orgs/{orgId}/members/{uid} doc and requires `active == true` and a
//    matching role, so deactivation/demotion takes effect immediately instead
//    of waiting up to an hour for the ID token to refresh.
//  - Cloud Functions use the Admin SDK and bypass these rules; everything that
//    is "server only" in the contract is simply `allow write: if false`.
//  - get() budget: at most 2 distinct documents are read per request
//    (the caller's member doc plus at most one of: the channel for channel
//    subcollections, the escalation policy on org update, or the parent
//    patient on document create, or the parent patient when a volunteer
//    reads patient events/documents). Repeated get() of the same path is
//    cached and billed once.
//  - v3 (docs/PERSONA_REVIEW.md L3, C2, S3): capabilities and discipline are
//    read from the caller's member doc (already fetched above, so no extra
//    get()). Admins implicitly hold every capability.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Generic helpers
    // ---------------------------------------------------------------------

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function claimOrg(orgId) {
      return signedIn() && request.auth.token.orgId == orgId;
    }

    function role() {
      return request.auth.token.role;
    }

    function memberDoc(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }

    // Claims say the caller belongs to the org AND their member doc is active.
    function isActiveMember(orgId) {
      return claimOrg(orgId) && memberDoc(orgId).data.active == true;
    }

    // Claims role and the (authoritative, immediately-revocable) member doc
    // role must both be in `roles`.
    function hasRole(orgId, roles) {
      return isActiveMember(orgId)
        && role() in roles
        && memberDoc(orgId).data.role in roles;
    }

    function isAdmin(orgId) {
      return hasRole(orgId, ['admin']);
    }

    // v3 capability strings (functions/src/shared/types.ts CAPABILITIES).
    function capabilityList() {
      return ['reports', 'audit', 'staffing', 'scheduling', 'volunteers', 'bereavement'];
    }

    // Admin, or an active member granted `cap` in member.capabilities.
    function hasCap(orgId, cap) {
      return isAdmin(orgId)
        || (isActiveMember(orgId) && cap in memberDoc(orgId).data.get('capabilities', []));
    }

    // Admin, or an active RN/NP/MD (LICENSED_DISCIPLINES).
    function isLicensed(orgId) {
      return isAdmin(orgId)
        || (isActiveMember(orgId) && memberDoc(orgId).data.discipline in ['RN', 'NP', 'MD']);
    }

    // Active Aide/LPN (FIELD_DISCIPLINES): may message even with role `viewer`.
    function isFieldStaff(orgId) {
      return isActiveMember(orgId) && memberDoc(orgId).data.discipline in ['Aide', 'LPN'];
    }

    // v3 minimum-necessary: a non-admin member whose discipline is Volunteer.
    function isVolunteer(orgId) {
      return isActiveMember(orgId)
        && memberDoc(orgId).data.discipline == 'Volunteer'
        && !isAdmin(orgId);
    }

    // Active member who is not a (non-admin) volunteer.
    function isStaffMember(orgId) {
      return isActiveMember(orgId) && !isVolunteer(orgId);
    }

    // v3: aides/LPNs with role `viewer` can message their RN.
    // `me` is the caller's member doc data (active already checked).
    function canPostAs(me) {
      return (role() in ['admin', 'clinician', 'intake'] && me.role in ['admin', 'clinician', 'intake'])
        || (role() == 'viewer' && me.role == 'viewer' && me.discipline in ['Aide', 'LPN']);
    }

    function canPost(orgId) {
      return isActiveMember(orgId) && canPostAs(memberDoc(orgId).data);
    }

    // --- Shape helpers ----------------------------------------------------

    function incoming() {
      return request.resource.data;
    }

    function exactKeys(keys) {
      return incoming().keys().hasAll(keys) && incoming().keys().hasOnly(keys);
    }

    function onlyChanged(keys) {
      return incoming().diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isNonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    function isStringOrNull(v, maxLen) {
      return v == null || (v is string && v.size() <= maxLen);
    }

    function isRole(v) {
      return v in ['admin', 'clinician', 'intake', 'viewer'];
    }

    function isDiscipline(v) {
      return v in ['RN', 'LPN', 'MD', 'NP', 'SW', 'Chaplain', 'Aide', 'Volunteer', 'Admin', 'Other'];
    }

    function isPriority(v) {
      return v in ['normal', 'urgent', 'critical'];
    }

    // ISO calendar date `YYYY-MM-DD` (format only; calendar validity is not checked).
    function isIsoDate(v) {
      return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function isIntInRange(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    // A single path segment usable as a Storage object name.
    function isFileName(v) {
      return isNonEmptyString(v, 255) && v.matches('[^/]+') && v != '.' && v != '..';
    }

    function isPdfOrImage(v) {
      return v is string && (v == 'application/pdf' || v.matches('image/.*'));
    }

    function isMilestoneKind(v) {
      return v in ['noe', 'recert', 'f2f', 'hope_admission', 'hope_huv1', 'hope_huv2', 'aide_supervision'];
    }

    // Optional per-kind override of deadlineLeadDays: {kind: int 0..90}.
    function isLeadDaysByKind(m) {
      return m is map
        && m.keys().hasOnly(['noe', 'recert', 'f2f', 'hope_admission', 'hope_huv1', 'hope_huv2', 'aide_supervision'])
        && isIntInRange(m.get('noe', 0), 0, 90)
        && isIntInRange(m.get('recert', 0), 0, 90)
        && isIntInRange(m.get('f2f', 0), 0, 90)
        && isIntInRange(m.get('hope_admission', 0), 0, 90)
        && isIntInRange(m.get('hope_huv1', 0), 0, 90)
        && isIntInRange(m.get('hope_huv2', 0), 0, 90)
        && isIntInRange(m.get('aide_supervision', 0), 0, 90);
    }

    // At most 6 entries, each a known capability string.
    function isCapabilityList(v) {
      return v is list && v.size() <= 6 && v.hasOnly(capabilityList());
    }

    function isVolunteerActivity(v) {
      return v in ['companionship', 'respite', 'vigil', 'errands', 'bereavement', 'admin', 'other'];
    }

    // Clinical roles per DATA_MODEL v2: admin, clinician, intake.
    function isClinical(orgId) {
      return hasRole(orgId, ['admin', 'clinician', 'intake']);
    }

    // ---------------------------------------------------------------------
    // userOrgs/{uid} — org lookup before claims refresh. Server-written.
    // ---------------------------------------------------------------------
    match /userOrgs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // orgs/{orgId}
    // ---------------------------------------------------------------------
    match /orgs/{orgId} {
      allow read: if isActiveMember(orgId);

      // Created by `createOrg`; admins may only edit settings.
      // v2 settings are optional on the doc: `get(key, default)` validates
      // them when present and lets admins remove them (back to the default).
      allow create, delete: if false;
      allow update: if isAdmin(orgId)
        && onlyChanged(['name', 'timezone', 'deadlineLeadDays', 'defaultEscalationPolicyId',
                        'triageRoleKey', 'idgCadenceDays', 'missedVisitGraceMinutes',
                        'messageLifespanDays', 'deadlineLeadDaysByKind', 'missedVisitAlertMode',
                        'defaultBereavementCoordinatorUid', 'patientChannelRetentionDays'])
        && isNonEmptyString(incoming().name, 200)
        && isNonEmptyString(incoming().timezone, 64)
        && incoming().deadlineLeadDays is int
        && incoming().deadlineLeadDays >= 0
        && incoming().deadlineLeadDays <= 90
        && (incoming().defaultEscalationPolicyId == null
            || (incoming().defaultEscalationPolicyId is string
                && exists(/databases/$(database)/documents/orgs/$(orgId)/escalationPolicies/$(incoming().defaultEscalationPolicyId))))
        && (incoming().get('triageRoleKey', null) == null
            || isNonEmptyString(incoming().get('triageRoleKey', null), 128))
        && isIntInRange(incoming().get('idgCadenceDays', 15), 1, 30)
        && isIntInRange(incoming().get('missedVisitGraceMinutes', 120), 15, 1440)
        && (incoming().get('messageLifespanDays', null) == null
            || isIntInRange(incoming().get('messageLifespanDays', null), 7, 3650))
        // v3 (S6): patient channels are purged only with a retention of at least 6 years.
        && (incoming().get('patientChannelRetentionDays', null) == null
            || isIntInRange(incoming().get('patientChannelRetentionDays', null), 2190, 36500))
        // v3 settings (optional).
        && isLeadDaysByKind(incoming().get('deadlineLeadDaysByKind', {}))
        && incoming().get('missedVisitAlertMode', 'assignee_admins')
             in ['assignee', 'assignee_admins', 'digest', 'off']
        && (incoming().get('defaultBereavementCoordinatorUid', null) == null
            || isNonEmptyString(incoming().get('defaultBereavementCoordinatorUid', null), 128));

      // -------------------------------------------------------------------
      // members/{uid} — created by `createOrg` / `acceptInvite`.
      // -------------------------------------------------------------------
      match /members/{uid} {
        allow read: if isActiveMember(orgId);
        allow create, delete: if false;

        allow update: if
          // Admin: any field, but keep the doc well-formed.
          (isAdmin(orgId)
            && incoming().uid == resource.data.uid
            && isRole(incoming().role)
            && isDiscipline(incoming().discipline)
            && incoming().active is bool
            && isNonEmptyString(incoming().displayName, 200)
            && isStringOrNull(incoming().title, 200)
            && isStringOrNull(incoming().phone, 50)
            && incoming().teamIds is list
            && incoming().fcmTokens is list
            && incoming().fcmTokens.size() <= 20
            // v3: optional capability grants (known strings only).
            && isCapabilityList(incoming().get('capabilities', [])))
          ||
          // Self: profile + device tokens only (never role, discipline,
          // capabilities, active or teamIds).
          (request.auth.uid == uid
            && isActiveMember(orgId)
            && onlyChanged(['fcmTokens', 'displayName', 'phone', 'title'])
            && incoming().fcmTokens is list
            && incoming().fcmTokens.size() <= 20
            && isNonEmptyString(incoming().displayName, 200)
            && isStringOrNull(incoming().phone, 50)
            && isStringOrNull(incoming().title, 200));
      }

      // -------------------------------------------------------------------
      // invites/{id} — `inviteMember` / `acceptInvite` only.
      // -------------------------------------------------------------------
      match /invites/{inviteId} {
        allow read: if isAdmin(orgId);
        allow write: if false;
      }

      // -------------------------------------------------------------------
      // Admin-managed configuration
      // -------------------------------------------------------------------
      match /teams/{teamId} {
        allow read: if isActiveMember(orgId);
        allow delete: if isAdmin(orgId);
        allow create, update: if isAdmin(orgId)
          && exactKeys(['name', 'description', 'memberUids', 'createdAt'])
          && isNonEmptyString(incoming().name, 200)
          && isStringOrNull(incoming().description, 2000)
          && incoming().memberUids is list
          && incoming().memberUids.size() <= 500
          && incoming().createdAt is timestamp;
      }

      // v3: `scheduling` capability (or admin) manages on-call roles and shifts.
      match /onCallRoles/{roleKey} {
        allow read: if isActiveMember(orgId);
        allow delete: if hasCap(orgId, 'scheduling');
        allow create, update: if hasCap(orgId, 'scheduling')
          && exactKeys(['label', 'discipline', 'teamId', 'fallbackUids'])
          && isNonEmptyString(incoming().label, 200)
          && (incoming().discipline == null || isDiscipline(incoming().discipline))
          && isStringOrNull(incoming().teamId, 128)
          && incoming().fallbackUids is list
          && incoming().fallbackUids.size() <= 50;
      }

      match /shifts/{shiftId} {
        allow read: if isActiveMember(orgId);
        allow delete: if hasCap(orgId, 'scheduling');
        allow create, update: if hasCap(orgId, 'scheduling')
          && exactKeys(['roleKey', 'uid', 'start', 'end', 'notes'])
          && isNonEmptyString(incoming().roleKey, 128)
          && isNonEmptyString(incoming().uid, 128)
          && incoming().start is timestamp
          && incoming().end is timestamp
          && incoming().end > incoming().start
          && isStringOrNull(incoming().notes, 2000);
      }

      match /escalationPolicies/{policyId} {
        allow read: if isActiveMember(orgId);
        allow delete: if isAdmin(orgId);
        allow create, update: if isAdmin(orgId)
          && exactKeys(['name', 'steps'])
          && isNonEmptyString(incoming().name, 200)
          && incoming().steps is list
          && incoming().steps.size() >= 1
          && incoming().steps.size() <= 10;
      }

      // -------------------------------------------------------------------
      // channels/{channelId} — created/updated by functions only.
      // -------------------------------------------------------------------
      match /channels/{channelId} {
        allow read: if isActiveMember(orgId)
          && request.auth.uid in resource.data.memberUids;
        allow write: if false;

        function channelDoc() {
          return get(/databases/$(database)/documents/orgs/$(orgId)/channels/$(channelId));
        }

        function isChannelMember() {
          return isActiveMember(orgId)
            && request.auth.uid in channelDoc().data.memberUids;
        }

        // L1: one message attachment: only {storagePath, contentType, name,
        // size} (a missing key errors on access, so the set is exact).
        // storagePath must match `pathRe`, i.e.
        // `orgs/{orgId}/channels/{channelId}/attachments/{fileName}` with a
        // single-segment fileName. orgId/channelId are server-generated ids
        // (no regex metacharacters). name: 1-200 chars; size: int 1..25 MB.
        // Kept lean and `pathRe` is built once by the caller: 10 attachments
        // must fit in the 1000-expression evaluation limit (tested).
        function isAttachment(a, pathRe) {
          return a.keys().hasOnly(['storagePath', 'contentType', 'name', 'size'])
            && a.storagePath.matches(pathRe)
            && a.contentType is string
            && a.name.matches('(?s).{1,200}')
            && a.size is int
            && a.size > 0
            && a.size <= 26214400;
        }

        function areAttachments(l, pathRe) {
          let n = l.size();
          return n <= 10
            && (n <= 0 || isAttachment(l[0], pathRe))
            && (n <= 1 || isAttachment(l[1], pathRe))
            && (n <= 2 || isAttachment(l[2], pathRe))
            && (n <= 3 || isAttachment(l[3], pathRe))
            && (n <= 4 || isAttachment(l[4], pathRe))
            && (n <= 5 || isAttachment(l[5], pathRe))
            && (n <= 6 || isAttachment(l[6], pathRe))
            && (n <= 7 || isAttachment(l[7], pathRe))
            && (n <= 8 || isAttachment(l[8], pathRe))
            && (n <= 9 || isAttachment(l[9], pathRe));
        }

        // Message create, given the caller's member doc data `me`, the channel
        // doc data `ch` and the incoming message `m`.
        function isValidNewMessage(me, ch, m) {
          return me.active == true
            && request.auth.uid in ch.memberUids
            && canPostAs(me)
            && ch.archived != true
            && (ch.type != 'broadcast' || ch.createdBy == request.auth.uid)
            && m.keys().hasAll(['senderUid', 'senderName', 'body', 'priority',
                                'attachments', 'roleTarget', 'createdAt', 'alertId'])
            && m.keys().hasOnly(['senderUid', 'senderName', 'body', 'priority',
                                 'attachments', 'roleTarget', 'createdAt', 'alertId',
                                 'threadParentId'])
            && (m.get('threadParentId', null) == null
                || isNonEmptyString(m.get('threadParentId', null), 128))
            && m.senderUid == request.auth.uid
            && isNonEmptyString(m.senderName, 200)
            // M1: senderName must be the caller's member displayName (member
            // doc already fetched; no extra get()).
            && m.senderName == me.displayName
            && m.body is string
            && m.body.size() <= 8000
            && isPriority(m.priority)
            && m.attachments is list
            && areAttachments(m.attachments,
                              'orgs/' + orgId + '/channels/' + channelId + '/attachments/[^/]+')
            && (m.body.size() > 0 || m.attachments.size() > 0)
            && m.roleTarget == null
            && m.createdAt == request.time
            && m.alertId == null;
        }

        // Clients write messages directly (offline-friendly); functions
        // fill in alertId and the channel's lastMessage.
        // v2: optional `threadParentId` (string or null) on create; in a
        // `broadcast` channel only its creator may post. The parent message
        // is not looked up here (get() budget); onMessageCreated handles it.
        match /messages/{messageId} {
          allow read: if isChannelMember();

          // Evaluated with the member doc, channel doc and message data
          // passed in once (keeps 10 attachments under the 1000-expression
          // limit; same two get()s as before).
          allow create: if claimOrg(orgId)
            && isValidNewMessage(memberDoc(orgId).data, channelDoc().data, incoming());

          allow update, delete: if false;
        }

        // Read receipts: each member maintains only their own.
        match /reads/{uid} {
          allow read: if isChannelMember();
          allow create, update: if request.auth.uid == uid
            && isChannelMember()
            && exactKeys(['lastReadAt'])
            && incoming().lastReadAt == request.time;
          allow delete: if false;
        }
      }

      // -------------------------------------------------------------------
      // alerts/{alertId} — created/acked/escalated by functions only.
      // -------------------------------------------------------------------
      match /alerts/{alertId} {
        allow read: if isActiveMember(orgId)
          && (request.auth.uid in resource.data.targetUids || isAdmin(orgId));
        allow write: if false;
      }

      // -------------------------------------------------------------------
      // patients/{patientId} — `admitPatient` / `acceptReferral` only.
      // -------------------------------------------------------------------
      //
      // v3 minimum-necessary: a Volunteer (non-admin) sees only patients
      // whose `volunteerUids` contains them. `volunteerUids` is maintained by
      // the backend (Cloud Functions) from the patient's ACTIVE
      // volunteerAssignments; clients never write it. A volunteer's list
      // query must filter where('volunteerUids', 'array-contains', uid).
      // -------------------------------------------------------------------
      match /patients/{patientId} {
        allow read: if isStaffMember(orgId)
          || (isVolunteer(orgId)
              && request.auth.uid in resource.data.get('volunteerUids', []));
        allow write: if false;

        // Volunteer access to subcollections follows the parent patient.
        // get() budget: member doc + this patient doc.
        function volunteerAssignedToPatient() {
          return isVolunteer(orgId)
            && request.auth.uid in get(/databases/$(database)/documents/orgs/$(orgId)/patients/$(patientId))
                                     .data.get('volunteerUids', []);
        }

        function canReadPatientChildren() {
          return isStaffMember(orgId) || volunteerAssignedToPatient();
        }

        // Timeline events — written only by functions.
        match /events/{eventId} {
          allow read: if canReadPatientChildren();
          allow write: if false;
        }

        // Patient documents: a clinical user creates the record, then
        // uploads the file to `storagePath`. Write-once from clients.
        // get() budget: member doc + parent patient existence.
        match /documents/{documentId} {
          allow read: if canReadPatientChildren();

          allow create: if isClinical(orgId)
            && exists(/databases/$(database)/documents/orgs/$(orgId)/patients/$(patientId))
            && exactKeys(['name', 'category', 'fileName', 'storagePath', 'contentType',
                          'size', 'uploadedBy', 'createdAt'])
            && isNonEmptyString(incoming().name, 200)
            && incoming().category in ['consent', 'polst', 'order', 'referral', 'plan_of_care', 'other']
            && isFileName(incoming().fileName)
            && incoming().storagePath == 'orgs/' + orgId + '/patients/' + patientId
                 + '/documents/' + documentId + '/' + incoming().fileName
            && isPdfOrImage(incoming().contentType)
            && incoming().size is int
            && incoming().size > 0
            && incoming().size < 25 * 1024 * 1024
            && incoming().uploadedBy == request.auth.uid
            && incoming().createdAt == request.time;

          allow update, delete: if false;
        }
      }

      // -------------------------------------------------------------------
      // v2 care workflows — read by members, written only by functions
      // (visits, tasks, templates, bereavement, IDG, triage).
      // v3: volunteers cannot read visits, tasks, IDG meetings or triage
      // calls at all. `bereavement` capability: no client writes yet (all
      // bereavement writes go through functions).
      // -------------------------------------------------------------------
      match /visits/{visitId} {
        allow read: if isStaffMember(orgId);
        allow write: if false;
      }

      match /tasks/{taskId} {
        allow read: if isStaffMember(orgId);
        allow write: if false;
      }

      // Edited through the admin-only `saveTaskTemplate` callable.
      match /taskTemplates/{event} {
        allow read: if isActiveMember(orgId);
        allow write: if false;
      }

      // M6: staff only (not volunteers).
      match /bereavementPlans/{planId} {
        allow read: if isStaffMember(orgId);
        allow write: if false;
      }

      match /idgMeetings/{meetingId} {
        allow read: if isStaffMember(orgId);
        allow write: if false;

        // v3 (F5, H3): per-discipline notes and AI prep. Same audience as the
        // meeting (staff, not volunteers); written only by functions.
        match /notes/{noteId} {
          allow read: if isStaffMember(orgId);
          allow write: if false;
        }
      }

      match /triageCalls/{callId} {
        allow read: if isStaffMember(orgId);
        allow write: if false;
      }

      // Dashboards: admin or `reports` capability.
      match /metrics/{date} {
        allow read: if hasCap(orgId, 'reports');
        allow write: if false;
      }

      // -------------------------------------------------------------------
      // Volunteers
      // -------------------------------------------------------------------
      function isVolunteerAssignment() {
        return exactKeys(['volunteerUid', 'patientId', 'patientName', 'activity', 'status',
                          'startDate', 'endDate', 'notes', 'createdBy', 'createdAt'])
          && isNonEmptyString(incoming().volunteerUid, 128)
          && isNonEmptyString(incoming().patientId, 128)
          && isNonEmptyString(incoming().patientName, 200)
          && isVolunteerActivity(incoming().activity)
          && incoming().status in ['active', 'ended']
          && isIsoDate(incoming().startDate)
          && (incoming().endDate == null
              || (isIsoDate(incoming().endDate) && incoming().endDate >= incoming().startDate))
          && isStringOrNull(incoming().notes, 2000);
      }

      // Managed by admin or the `volunteers` capability. createdBy/createdAt
      // are stamped on create and immutable. A Volunteer (without the
      // capability) reads only their own assignments; list queries must
      // filter where('volunteerUid', '==', uid).
      match /volunteerAssignments/{assignmentId} {
        allow read: if isStaffMember(orgId)
          || hasCap(orgId, 'volunteers')
          || (isVolunteer(orgId) && resource.data.volunteerUid == request.auth.uid);
        allow create: if hasCap(orgId, 'volunteers')
          && isVolunteerAssignment()
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time;
        allow update: if hasCap(orgId, 'volunteers')
          && isVolunteerAssignment()
          && incoming().createdBy == resource.data.createdBy
          && incoming().createdAt == resource.data.createdAt;
        allow delete: if hasCap(orgId, 'volunteers');
      }

      // Any active member logs their own time; admins and the `volunteers`
      // capability read all logs, others only their own (list queries must
      // filter volunteerUid == uid).
      // v3: coordinators (`volunteers` capability) may log for any volunteer;
      // then `enteredBy` is required and must be the caller. On a self-log
      // `enteredBy` is optional (absent, or the caller).
      match /volunteerLogs/{logId} {
        allow read: if hasCap(orgId, 'volunteers')
          || (isActiveMember(orgId) && resource.data.volunteerUid == request.auth.uid);

        allow create: if isActiveMember(orgId)
          && incoming().keys().hasAll(['volunteerUid', 'patientId', 'date', 'minutes', 'activity',
                                       'note', 'createdAt'])
          && incoming().keys().hasOnly(['volunteerUid', 'patientId', 'date', 'minutes', 'activity',
                                        'note', 'createdAt', 'enteredBy'])
          && isNonEmptyString(incoming().volunteerUid, 128)
          && ((incoming().volunteerUid == request.auth.uid
               && incoming().get('enteredBy', request.auth.uid) == request.auth.uid)
              || (incoming().volunteerUid != request.auth.uid
                  && incoming().get('enteredBy', null) == request.auth.uid
                  && hasCap(orgId, 'volunteers')))
          && (incoming().patientId == null || isNonEmptyString(incoming().patientId, 128))
          && isIsoDate(incoming().date)
          && isIntInRange(incoming().minutes, 1, 1440)
          && isVolunteerActivity(incoming().activity)
          && isStringOrNull(incoming().note, 2000)
          && incoming().createdAt == request.time;

        allow update, delete: if false;
      }

      // v3 (C2): `voidedAt`, `voidedBy`, `voidReason` on volunteerLogs are written only by the
      // `voidVolunteerLog` function: create above lists every allowed key (so a client can't
      // create a pre-voided log) and update/delete are denied.

      // v3 (C2): paid patient-care hours override for the volunteer 5% report,
      // `staffHours/{YYYY-MM}`. Admin or `reports` capability; exact shape
      // {paidCareHours: number 0..100000, updatedBy: caller, updatedAt: request.time}.
      // Client writes are audited by the `onStaffHoursWritten` trigger.
      match /staffHours/{month} {
        allow read: if hasCap(orgId, 'reports');
        allow delete: if hasCap(orgId, 'reports') && month.matches('[0-9]{4}-(0[1-9]|1[0-2])');
        allow create, update: if hasCap(orgId, 'reports')
          && month.matches('[0-9]{4}-(0[1-9]|1[0-2])')
          && exactKeys(['paidCareHours', 'updatedBy', 'updatedAt'])
          && (incoming().paidCareHours is int || incoming().paidCareHours is float)
          && incoming().paidCareHours >= 0
          && incoming().paidCareHours <= 100000
          && incoming().updatedBy == request.auth.uid
          && incoming().updatedAt == request.time;
      }

      // -------------------------------------------------------------------
      // referrals/{referralId} — client creates the record, then uploads
      // the file; everything after that is server-side.
      // -------------------------------------------------------------------
      match /referrals/{referralId} {
        allow read: if hasRole(orgId, ['admin', 'clinician', 'intake']);

        allow create: if hasRole(orgId, ['admin', 'clinician', 'intake'])
          && exactKeys(['fileName', 'contentType', 'storagePath', 'source', 'status',
                        'extracted', 'error', 'model', 'patientId', 'uploadedBy',
                        'reviewedBy', 'rejectionReason', 'createdAt', 'updatedAt'])
          && incoming().status == 'uploaded'
          && incoming().uploadedBy == request.auth.uid
          && incoming().source in ['scan', 'upload', 'fax']
          && isNonEmptyString(incoming().fileName, 255)
          && incoming().fileName.matches('[^/]+')
          && incoming().fileName != '.'
          && incoming().fileName != '..'
          && incoming().contentType is string
          // v3 (I1): exactly REFERRAL_MIME_TYPES in shared/types.ts (what the extractor accepts).
          && incoming().contentType in ['application/pdf', 'image/png', 'image/jpeg', 'image/webp', 'image/heic', 'image/heif']
          && incoming().storagePath == 'orgs/' + orgId + '/referrals/' + referralId + '/' + incoming().fileName
          && incoming().extracted == null
          && incoming().error == null
          && incoming().model == null
          && incoming().patientId == null
          && incoming().reviewedBy == null
          && incoming().rejectionReason == null
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update, delete: if false;
      }

      // -------------------------------------------------------------------
      // auditLogs/{id} — written only by Cloud Functions.
      // -------------------------------------------------------------------
      // v3: readable by admin or the `audit` capability.
      // v3 (S6): originals of recalled messages (admin or `audit` capability).
      match /messageRecalls/{recallId} {
        allow read: if hasCap(orgId, 'audit');
        allow write: if false;
      }

      // v3 (M4): per-user rate-limit buckets; functions only.
      match /rateLimits/{bucketId} {
        allow read, write: if false;
      }

      match /auditLogs/{logId} {
        allow read: if hasCap(orgId, 'audit');
        allow write: if false;
      }
    }

    // Everything else is denied by default (no catch-all match).
  }
}
